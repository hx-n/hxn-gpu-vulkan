          "params": [{ "name": "offset", "type": "i64" }, { "name": "bytes", "type": "bytes" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "read",
          "docs": "`length` bytes from `offset`.",
          "kind": "method",
          "params": [{ "name": "offset", "type": "i64" }, { "name": "length", "type": "i64" }],
          "returns": "bytes",
          "fallible": true,
          "blocking": false
        }
      ]
