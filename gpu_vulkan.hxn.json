    },
    {
      "name": "ShaderStage",
      "docs": "Shader stage bits, Vulkan's values, or-ed together.",
      "variants": [{ "name": "Vertex", "value": 1 }, { "name": "Fragment", "value": 16 }, { "name": "Compute", "value": 32 }]
    },
    {
      "name": "Topology",
      "variants": [{ "name": "PointList", "value": 0 }, { "name": "LineList", "value": 1 }, { "name": "LineStrip", "value": 2 }, { "name": "TriangleList", "value": 3 }, { "name": "TriangleStrip", "value": 4 }]
