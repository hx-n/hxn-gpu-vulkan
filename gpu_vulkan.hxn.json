      "name": "Image",
      "docs": "A 2D image in device memory, with one view of all of it.",
      "methods": [
        {
          "name": "width",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "height",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        }
