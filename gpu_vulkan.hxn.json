      "name": "Sampler",
      "methods": []
    },
    {
      "name": "ShaderModule",
      "methods": []
    },
    {
      "name": "SetLayouts",
      "docs": "The descriptor set layouts of a pipeline, set 0 first.",
      "methods": [
        {
          "name": "count",
          "docs": "How many sets there are.",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        }
      ]
    },
    {
      "name": "PipelineLayout",
      "methods": []
    },
    {
      "name": "Pipeline",
      "methods": []
    },
    {
      "name": "DescriptorSet",
      "docs": "A descriptor set, written binding by binding before a command buffer binds it.",
      "methods": [
        {
          "name": "write_buffer",
          "docs": "Points `binding`, a uniform or storage buffer, at `size` bytes of `buffer` from `offset`.",
          "kind": "mutating",
          "params": [{ "name": "binding", "type": "i32" }, { "name": "buffer", "type": "Buffer" }, { "name": "offset", "type": "i64" }, { "name": "size", "type": "i64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "write_image",
          "docs": "Points `binding`, a sampled or storage image, at `image` in `layout`.",
          "kind": "mutating",
          "params": [{ "name": "binding", "type": "i32" }, { "name": "image", "type": "Image" }, { "name": "layout", "type": "Layout" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "write_sampler",
          "docs": "Points `binding`, a sampler, at `sampler`.",
          "kind": "mutating",
          "params": [{ "name": "binding", "type": "i32" }, { "name": "sampler", "type": "Sampler" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        }
      ]
    },
    {
      "name": "CommandBuffer",
      "docs": "Records commands until a `Device.submit`. Not thread-safe: its methods take `&mut self`.",
      "methods": [
        {
          "name": "bind_pipeline",
          "kind": "mutating",
          "params": [{ "name": "point", "type": "BindPoint" }, { "name": "pipeline", "type": "Pipeline" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "bind_descriptor_set",
          "docs": "Binds `set` as set `index` of `layout`: hxnsl's bind group `index`.",
          "kind": "mutating",
          "params": [{ "name": "point", "type": "BindPoint" }, { "name": "layout", "type": "PipelineLayout" }, { "name": "index", "type": "i32" }, { "name": "set", "type": "DescriptorSet" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "dispatch",
          "kind": "mutating",
          "params": [{ "name": "x", "type": "i32" }, { "name": "y", "type": "i32" }, { "name": "z", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "buffer_barrier",
          "docs": "A barrier on all of `buffer`: work in `src_stages` doing `src_access` finishes, and its\nwrites are visible, before work in `dst_stages` doing `dst_access` starts.",
          "kind": "mutating",
          "params": [{ "name": "buffer", "type": "Buffer" }, { "name": "src_stages", "type": "i32" }, { "name": "src_access", "type": "i32" }, { "name": "dst_stages", "type": "i32" }, { "name": "dst_access", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "image_barrier",
          "docs": "A barrier on all of `image` that also moves it from layout `from` to `to`.",
          "kind": "mutating",
          "params": [{ "name": "image", "type": "Image" }, { "name": "src_stages", "type": "i32" }, { "name": "src_access", "type": "i32" }, { "name": "from", "type": "Layout" }, { "name": "dst_stages", "type": "i32" }, { "name": "dst_access", "type": "i32" }, { "name": "to", "type": "Layout" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "memory_barrier",
          "docs": "A barrier on all memory, for work that touches more than one resource.",
          "kind": "mutating",
          "params": [{ "name": "src_stages", "type": "i32" }, { "name": "src_access", "type": "i32" }, { "name": "dst_stages", "type": "i32" }, { "name": "dst_access", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "begin_rendering",
          "docs": "Begins rendering into `target`, which must be in the color attachment layout, starting\nfrom it as it is, cleared to `red`, `green`, `blue`, `alpha`, or undefined. Sets the\nviewport and scissor to all of it.",
          "kind": "mutating",
          "params": [{ "name": "target", "type": "Image" }, { "name": "load", "type": "LoadOp" }, { "name": "red", "type": "f64" }, { "name": "green", "type": "f64" }, { "name": "blue", "type": "f64" }, { "name": "alpha", "type": "f64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "end_rendering",
          "kind": "mutating",
          "params": [],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "bind_vertex_buffer",
          "kind": "mutating",
          "params": [{ "name": "binding", "type": "i32" }, { "name": "buffer", "type": "Buffer" }, { "name": "offset", "type": "i64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "draw",
          "docs": "Draws `count` vertices from `first`, `instances` times.",
          "kind": "mutating",
          "params": [{ "name": "count", "type": "i32" }, { "name": "instances", "type": "i32" }, { "name": "first", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "copy_image_to_buffer",
          "docs": "Copies all of `image`, which must be in the transfer source layout, into `buffer`, rows\npacked.",
          "kind": "mutating",
          "params": [{ "name": "image", "type": "Image" }, { "name": "buffer", "type": "Buffer" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        }
      ]
    }
  ]
}
