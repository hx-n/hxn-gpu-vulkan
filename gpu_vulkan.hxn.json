  "records": [
    {
      "name": "ImageDescriptor",
      "fields": [
        { "name": "width", "type": "i32" },
        { "name": "height", "type": "i32" },
        { "name": "format", "type": "Format" },
        { "name": "usage", "type": "i32" }
      ]
    },
    {
      "name": "LayoutBinding",
      "docs": "One binding of a descriptor set layout.",
      "fields": [
        { "name": "binding", "type": "i32" },
        { "name": "kind", "type": "DescriptorType" },
        { "name": "stages", "type": "i32" }
      ]
    },
    {
      "name": "SetLayout",
      "docs": "One descriptor set's bindings: one of hxnsl's bind groups.",
      "fields": [
        { "name": "bindings", "type": "list<LayoutBinding>" }
      ]
    },
    {
      "name": "VertexAttribute",
      "docs": "One vertex attribute: `location` is the shader's (hxnsl's `INPUT_<name>`).",
      "fields": [
        { "name": "location", "type": "i32" },
        { "name": "binding", "type": "i32" },
        { "name": "format", "type": "Format" },
        { "name": "offset", "type": "i32" }
      ]
    },
    {
      "name": "VertexBinding",
      "docs": "One vertex buffer binding: its stride in bytes, and whether it advances per instance.",
      "fields": [
        { "name": "binding", "type": "i32" },
        { "name": "stride", "type": "i32" },
        { "name": "per_instance", "type": "bool" }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Instance",
      "docs": "A Vulkan instance: the loader, and the GPUs it finds.",
      "methods": [
        {
          "name": "create",
          "docs": "An instance for the application `name`. Fails where no Vulkan loader or driver is\ninstalled. Asks for Vulkan 1.3, which the driver may lower.",
          "kind": "static",
          "params": [{ "name": "name", "type": "str" }],
          "returns": "Instance",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "adapter_names",
          "docs": "The name of each GPU, in the order `createDevice` takes them.",
          "kind": "method",
          "params": [],
          "returns": "list<str>",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "create_device",
          "docs": "A device on GPU `index`, with one queue that does graphics and compute. Fails if the\nGPU lacks dynamic rendering or synchronization2.",
          "kind": "method",
          "params": [{ "name": "index", "type": "i32" }],
          "returns": "Device",
          "fallible": true,
          "blocking": false
        }
      ]
    },
    {
      "name": "Device",
      "docs": "A logical device and its queue; every other object comes from one.",
      "methods": [
        {
          "name": "create_buffer",
          "docs": "A buffer of `size` bytes in memory the CPU can map, zeroed, with `usage` bits.",
          "kind": "method",
          "params": [{ "name": "size", "type": "i64" }, { "name": "usage", "type": "i32" }],
          "returns": "Buffer",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_buffer_with",
          "docs": "A buffer holding a copy of `bytes`.",
          "kind": "method",
          "params": [{ "name": "bytes", "type": "bytes" }, { "name": "usage", "type": "i32" }],
          "returns": "Buffer",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_image",
          "docs": "A 2D image in device memory, in the undefined layout, with one view of all of it.",
          "kind": "method",
          "params": [{ "name": "descriptor", "type": "ImageDescriptor" }],
          "returns": "Image",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_sampler",
          "kind": "method",
          "params": [{ "name": "min", "type": "Filter" }, { "name": "mag", "type": "Filter" }, { "name": "address", "type": "AddressMode" }],
          "returns": "Sampler",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_shader_module",
          "docs": "A shader module from SPIR-V: hxnsl's `spirv()`.",
          "kind": "method",
          "params": [{ "name": "spirv", "type": "bytes" }],
          "returns": "ShaderModule",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_set_layouts",
          "docs": "The descriptor set layouts of a pipeline, set 0 first: one per hxnsl bind group.",
          "kind": "method",
          "params": [{ "name": "sets", "type": "list<SetLayout>" }],
          "returns": "SetLayouts",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_pipeline_layout",
          "docs": "A pipeline layout of all of `sets`.",
          "kind": "method",
          "params": [{ "name": "sets", "type": "SetLayouts" }],
          "returns": "PipelineLayout",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_descriptor_set",
          "docs": "A descriptor set of set `index` of `sets`, from a pool of its own.",
          "kind": "method",
          "params": [{ "name": "sets", "type": "SetLayouts" }, { "name": "index", "type": "i32" }],
          "returns": "DescriptorSet",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_compute_pipeline",
          "docs": "A compute pipeline running `entry` of `module`: hxnsl's entry point names (`main`).",
          "kind": "method",
          "params": [{ "name": "module", "type": "ShaderModule" }, { "name": "entry", "type": "str" }, { "name": "layout", "type": "PipelineLayout" }],
          "returns": "Pipeline",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_graphics_pipeline",
          "docs": "A graphics pipeline for dynamic rendering into one color attachment of `format`, with a\ndynamic viewport and scissor, no blending and no culling.",
          "kind": "method",
          "params": [{ "name": "vertex", "type": "ShaderModule" }, { "name": "vertex_entry", "type": "str" }, { "name": "fragment", "type": "ShaderModule" }, { "name": "fragment_entry", "type": "str" }, { "name": "layout", "type": "PipelineLayout" }, { "name": "format", "type": "Format" }, { "name": "topology", "type": "Topology" }, { "name": "bindings", "type": "list<VertexBinding>" }, { "name": "attributes", "type": "list<VertexAttribute>" }],
          "returns": "Pipeline",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "create_command_buffer",
          "docs": "A primary command buffer, from a pool of its own, ready to record.",
          "kind": "method",
          "params": [],
          "returns": "CommandBuffer",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "submit_and_wait",
          "docs": "Submits `commands`, ending it first, and waits for the GPU to finish them.",
          "kind": "method",
          "params": [{ "name": "commands", "type": "CommandBuffer", "borrow": "exclusive" }],
          "returns": "void",
          "fallible": true,
          "blocking": true
        },
        {
          "name": "submit",
          "docs": "Submits `commands`, ending it first. The future settles when the GPU has finished them.",
          "kind": "method",
          "params": [{ "name": "commands", "type": "CommandBuffer", "borrow": "exclusive" }],
          "returns": "future<void>",
          "fallible": true,
          "blocking": false
        }
      ]
    },
    {
      "name": "Buffer",
      "docs": "Memory the CPU maps for as long as the buffer lives.",
      "methods": [
        {
          "name": "size",
          "kind": "method",
